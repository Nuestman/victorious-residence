# Neon / PostgreSQL connection string
# Local: use the Neon **development** branch connection string (see docs/local-development.md).
# Vercel staging/production: use the Neon production (or staging) branch — never the local development URL.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Public app URL (optional locally; set on Vercel if auth redirects misbehave)
# AUTH_URL=http://localhost:17017
# Or on Vercel: AUTH_URL=https://your-app.vercel.app

# Days before an unpaid booking application (no deposit yet) is auto-closed.
# Deposit-backed reservations are not auto-released by this timer.
# BOOKING_APPLICATION_ABANDON_DAYS=14

# Protects /api/cron/expire-bookings (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace-with-a-long-random-secret

# Resend — contact form notifications + staff replies
RESEND_API_KEY=re_xxxxxxxx
# Verified sender used for outbound mail (bare email or "Name <email>")
RESEND_FROM_EMAIL=victoriousresidence@gmail.com
