# Neon / PostgreSQL connection string
# Required at runtime (set the same values in the Vercel project → Settings → Environment Variables)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Public app URL (optional locally; set on Vercel if auth redirects misbehave)
# AUTH_URL=http://localhost:17017
# Or on Vercel: AUTH_URL=https://your-app.vercel.app

# Booking hold window in hours
BOOKING_HOLD_HOURS=48

# Protects /api/cron/expire-bookings (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace-with-a-long-random-secret
